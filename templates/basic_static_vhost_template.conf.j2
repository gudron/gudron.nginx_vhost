{{ ansible_managed | comment }}

{%- if vhost.cert_file_path is defined -%}
server {
    listen {{ vhost.listen_host | default('*') }}:80;
    listen {{ vhost.listen_host | default('*') }}:8080;

    server_name {{ vhost.domain }};

    location ^~ / {
        return 301 https://$server_name$request_uri;
    }
}
{% endif %}

server {
    listen       {{ vhost.listen_host | default('*') }}:{{ vhost.listen.port | default(8080) }} {{ listen_protocol| default('') }};

    server_name {{ vhost.domain }};

    server_tokens off;

    charset {{ vhost.charset | default(host_params.chartset) }};

{% if vhost.cert_file_path is defined %}
    ssl_certificate         {{ vhost.cert_file_path }};
    ssl_certificate_key     {{ vhost.private_key_file_path }};
{% endif %}

    set $app_root "{{vhost.root}}";

    root $app_root;

{% for header in vhost.headers %}
    add_header {{ header.name | title }} "{{ header.value }}" {% if header.always is defined and header.always -%} always {%- endif -%};
{% endfor %}

    location / {
        root $app_root;
        index  index.html;
        try_files $uri $uri/ /$uri?$args;
    }

{% for include_path in include_params + vhost.include_params | default([]) %}
    include {{include_path}};
{% endfor %}

}