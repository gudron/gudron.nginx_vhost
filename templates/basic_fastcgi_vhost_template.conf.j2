{{ ansible_managed | comment }}

upstream {{alias}}-upstream {
{% for backend in vhost.backends %}
    server {{backend.address}}:{{backend.listen.port}};
{% endfor %}
}

{%- if vhost.cert_file_path is defined -%}
server {
    listen {{ vhost.listen_host | default('*') }}:{{ vhost.listen.port | default(80) }} {{ listen_protocol| default('') }};

    server_name {{ vhost.domain }};

    {% for hader_name, header_value in vhost_headers_params + vhost.headers %}
    add_header  {{ hader_name | title }} "{{ header_value }}";
    {% endfor %}

    location ^~ / {
        return 301 https://$server_name$request_uri;
    }
}
{% endif %}

server {
    listen {{ vhost.listen_host | default('*') }}:{{ vhost.listen.port | default(443) }} {%- if vhost.cert_file_path is defined -%} ssl {% endif %} {{ listen_protocol| default('') }};

    server_name {{ vhost.domain }};

    server_tokens off;

    charset {{ vhost.charset | default(host_params.chartset) }};

    {%- if vhost.cert_file_path is defined -%}
    ssl_certificate         {{ vhost.cert_file_path }};
    ssl_certificate_key     {{ vhost.private_key_file_path }};
    {% endif %}

{% for header in vhost.headers %}
    add_header {{ header.name | title }}: "{{ header.value }}" {% if header.always is defined and header.always -%} always {%- endif -%};
{% endfor %}

    set $bootstrap "{{ vhost.bootstrap | default('index.php')}}";
    set $app_root "{{vhost.root}}";

    root $app_root;

    location / {
        root $app_root;
        index  index.html $bootstrap;
        try_files $uri $uri/ /$bootstrap?$args;
    }

{% for include_path in include_params + vhost.include_params | default([]) %}
    include {{include_path}};
{% endfor %}

    location ~ \.{{vhost.bootstrap.split(".")[1] }}$ {
        root $app_root;

        fastcgi_pass {{alias}}-upstream;
        fastcgi_index {{vhost.bootstrap}};


    {% for param_name, param_value in vhost_fastcgi_params.items() %}
        fastcgi_param {{ param_name | upper }} {{ param_value }};
    {% endfor %}

    }
}